# Canonical origin of the marketing site. Used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://quantora.app

# Where every "Start for free" / "Get started" / "Sign in" CTA points.
# Leave empty while the product is not public: CTAs then fall back to the
# on-page anchor instead of sending traffic to a dead link.
NEXT_PUBLIC_APP_URL=
